# AI reaction endpoint (used by the Docker container)
# The static site pings /api/reactions for AI-predicted reactions when
# this server is available; otherwise it falls back to the static index.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Host port for the container's 8080 (docker compose).
# ELECTRON_PORT=8080

# Optional: point the static site at a different reaction API host.
# NEXT_PUBLIC_REACTION_API=/api/reactions
